<odoo>
    <data>
        <template id="maintenance_recovery">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <t t-set="dt" t-value="lambda d: d and d.strftime('%d-%m-%Y') or ''"/>
                    <style>
                        .rr { font-family: 'Roboto', sans-serif; color: #1f2a44; }
                        .rr table { width: 100%; border-collapse: collapse; }
                        .rr-head td { border: 0; vertical-align: middle; }
                        .rr-head img { max-height: 60px; max-width: 170px; }
                        .rr-title { text-align: center; font-size: 20px; font-weight: bold; color: #2b4c7e; }
                        .rr-filters td { border: 0; font-size: 12px; padding: 3px 6px; }
                        .rr-filters td.lbl { font-weight: bold; width: 12%; }
                        .rr-filters td.val { background-color: #f6f8fb; }
                        .rr-t { margin-top: 12px; }
                        .rr-t th, .rr-t td { border: 1px solid #c5cee0; padding: 4px 6px; font-size: 12px; }
                        .rr-t thead th { background-color: #e8eef8; color: #1f2a44; font-weight: bold; text-align: center; }
                        .rr-t tr.rr-sum td { background-color: #f3f5f9; font-weight: bold; }
                        .rr-t tbody tr:nth-child(even) td { background-color: #fafbfd; }
                        .rr-t .num { text-align: right; white-space: nowrap; }
                        .rr-t .c { text-align: center; white-space: nowrap; }
                        thead { display: table-header-group; }
                        tr { page-break-inside: avoid; }
                    </style>
                    <div class="page rr">
                        <table class="rr-head" style="border-bottom: 1px solid #c5cee0; margin-bottom: 8px;">
                            <tr>
                                <td style="width: 25%; padding-bottom: 6px;">
                                    <img t-if="not company.uses_default_logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                                </td>
                                <td class="rr-title">Maintenance Recovery Report</td>
                                <td style="width: 25%; text-align: right; font-size: 12px;">
                                    <div style="font-weight: bold;"><t t-out="company.name"/></div>
                                    <div>Print Date: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></div>
                                </td>
                            </tr>
                        </table>

                        <table class="rr-filters">
                            <tr>
                                <td class="lbl">Date From:</td><td class="val"><t t-out="dt(date_from)"/></td>
                                <td class="lbl">Date To:</td><td class="val"><t t-out="dt(date_to)"/></td>
                                <td class="lbl">Society:</td><td class="val"><t t-out="society.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Sector:</td><td class="val"><t t-out="', '.join(sector_ids.mapped('name')) or 'All'"/></td>
                                <td class="lbl">Category:</td><td class="val"><t t-out="category_id.name or 'All'"/></td>
                                <td class="lbl">Product:</td><td class="val"><t t-out="product.name or 'All'"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Agents:</td><td class="val" colspan="5"><t t-out="', '.join(agent_ids.mapped('name')) or 'All'"/></td>
                            </tr>
                        </table>

                        <table class="rr-t" style="width: 60%;">
                            <thead>
                                <tr><th>Files</th><th>Billed</th><th>Amount Paid</th><th>Amount Due</th><th>Recovery %</th></tr>
                            </thead>
                            <tbody>
                                <tr class="rr-sum">
                                    <td class="c"><t t-out="len(rows)"/></td>
                                    <td class="num"><t t-out="fmt(total_amount)"/></td>
                                    <td class="num"><t t-out="fmt(total_paid)"/></td>
                                    <td class="num"><t t-out="fmt(total_due)"/></td>
                                    <td class="num"><t t-out="'{:.1f} %'.format(100.0 * total_paid / total_amount) if total_amount else '-'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="rr-t">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th>File No.</th>
                                    <th>Member Name</th>
                                    <th>Mobile</th>
                                    <th>Sector</th>
                                    <th>Plot No</th>
                                    <th>Agent</th>
                                    <th>Billed</th>
                                    <th>Amount Paid</th>
                                    <th>Amount Due</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <t t-set="file" t-value="row['file']"/>
                                    <td class="c"><t t-out="row_index + 1"/></td>
                                    <td><t t-out="file.display_name"/></td>
                                    <td><t t-out="file.membership_id.name"/></td>
                                    <td><t t-out="file.membership_id.mobile"/></td>
                                    <td><t t-out="file.sector_id.name"/></td>
                                    <td><t t-out="file.unit_number"/></td>
                                    <td><t t-out="file.maintenance_recovery_agent_id.name"/></td>
                                    <td class="num"><t t-out="fmt(row['amount'])"/></td>
                                    <td class="num"><t t-out="fmt(row['paid'])"/></td>
                                    <td class="num"><t t-out="fmt(row['due'])"/></td>
                                    <td class="c"><t t-out="row['status']"/></td>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="11" class="c">No maintenance bills for the selected filters.</td>
                                </tr>
                                <tr class="rr-sum">
                                    <td colspan="7">Total</td>
                                    <td class="num"><t t-out="fmt(total_amount)"/></td>
                                    <td class="num"><t t-out="fmt(total_paid)"/></td>
                                    <td class="num"><t t-out="fmt(total_due)"/></td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
