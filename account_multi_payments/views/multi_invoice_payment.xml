<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="multi_invoice_payment_tree">
            <field name="name">Multi Invoice Payment Tree</field>
            <field name="model">multi.invoice.payment</field>
            <field name="arch" type="xml">
                <list string="Multi Payment Logs" editable="bottom">
                    <field name="invoice_id"/>
                    <field name="invoice_date"/>
                    <field name="invoice_date_due"/>
                    <field name="amount_total_signed" string="Total"/>
                    <field name="payment_due" string="Amount Due" readonly="1"/>
                    <field name="payment_amount"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="multi_invoice_payment_receivables_action" model="ir.actions.act_window">
            <field name="name">Multi Payment Invoice</field>
            <field name="res_model">multi.invoice.payment</field>
            <field name="domain">[('move_type', 'in', ['out_invoice','in_refund'])]</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="multi_invoice_payment_tree"/>
        </record>

        <record id="multi_invoice_payment_payables_action" model="ir.actions.act_window">
            <field name="name">Multi Payment Invoice</field>
            <field name="res_model">multi.invoice.payment</field>
            <field name="domain">[('move_type', 'in', ['in_invoice','out_refund'])]</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="multi_invoice_payment_tree"/>
        </record>
    </data>
</odoo>