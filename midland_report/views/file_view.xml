<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="file_form_inherit_print_report" model="ir.ui.view">
        <field name="name">file.form.inherit.midland.print.report</field>
        <field name="model">file</field>
        <field name="inherit_id" ref="real_estate.file_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <!-- Replaces the old single-report "Print PDF" shortcut
                     (2026-09-18): Odoo's own multi-report Print entry only
                     shows inside the cog/Actions menu on form views (it's
                     list/kanban-only as a standalone button), so this widget
                     gives a real, visible "Print" button whose dropdown lists
                     every report currently bound to file (binding_type=report)
                     - see static/src/js/file_print_button.js. -->
                <widget name="file_print_button"/>
            </div>
        </field>
    </record>
</odoo>