<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_dealers_statement_report" model="report.paperformat">
        <field name="name">Dealer Statement Report</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_dealer_statements" model="ir.actions.report">
        <field name="name">Dealer Statement Report</field>
        <field name="model">dealer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dealers_statement_report.dealer_statement</field>
        <field name="report_file">dealers_statement_report.dealer_statement</field>
        <field name="paperformat_id" ref="paperformat_dealers_statement_report"/>
    </record>
</odoo>
