<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dealer_statement_header">
        <div class="header">
            <div class="row" style="font-family:'Roboto',sans-serif;">
                <div class="col-4">
                    <img t-if="o.env.company.logo" t-att-src="image_data_uri(o.env.company.logo)" alt="Logo"
                         style="max-width: 260px;max-height: 70px;"/>
                </div>
                <div class="col-4">
                    <div class="row text-center" style="color:#fff;">
                        <div class="col-12">
                            <h4 class="text-capitalize">
                                <strong style="background-color:#191970;vertical-align:middle !important;">
                                    <br/>
                                    &amp;nbsp;DEALER STATEMENT REPORT&amp;nbsp;
                                </strong>
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-4" name="company_address" style="font-size:10px; text-align:right;">
                    <ul class="list-unstyled">
                        <strong>
                            <li t-if="o.env.company.name">
                                <span t-field="o.env.company.name"/>
                            </li>
                        </strong>
                        <li t-if="o.env.company.street">
                            <span t-field="o.env.company.street"/>
                        </li>
                        <li t-if="o.env.company.street2">
                            <span t-field="o.env.company.street2"/>
                            <span t-field="o.env.company.city"/>
                        </li>
                        <li t-if="o.env.company.country_id">
                            <span t-field="o.env.company.country_id.name"/>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </template>

    <template id="dealer_statement_footer">
        <div class="footer">
            <div class="row" style="font-size:12px;font-family:'Roboto',sans-serif;color:#C39103;">
                <div class="col-6 text-left">
                    <span>Printed By:
                        <span t-esc="printed_by"/>
                        On
                        <span t-esc="print_date"/>
                    </span>
                </div>
                <div class="col-6 text-right">
                    Page No.&amp;nbsp;<span class="page"/>&amp;nbsp;/<span class="topage"/>
                </div>
            </div>
        </div>
    </template>

    <template id="dealer_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="dealers_statement_report.dealer_statement_header"/>
                <t t-call="dealers_statement_report.dealer_statement_footer"/>
                <t t-call="web.basic_layout">
                    <div class="page text-dark">
                        <div class="row">
                            <div class="col-12">
                                <div class="row" style="color:black;">
                                    <div class="col-6">
                                        <div class="row" style="color:black;">
                                            <div class="col-4"><b>Investor:</b></div>
                                            <div class="col-8">
                                                <span t-if="o.investor_id" t-esc="o.investor_id.investor_id"/>
                                                <span t-else="">All</span>
                                            </div>
                                        </div>
                                        <div class="row" style="color:black;" t-if="o.date_from">
                                            <div class="col-4"><b>Date From:</b></div>
                                            <div class="col-8">
                                                <span t-field="o.date_from"/>
                                            </div>
                                        </div>
                                        <div class="row" style="color:black;">
                                            <div class="col-4"><b>Type:</b></div>
                                            <div class="col-8">
                                                <span t-if="o.report_type == 'summary'">Summary</span>
                                                <span t-else="">Detailed</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="row" style="color:black;">
                                            <div class="col-4"><b>Investments:</b></div>
                                            <div class="col-8">
                                                <t t-if="o.investment_ids">
                                                    <t t-foreach="o.investment_ids" t-as="investment">
                                                        <span t-esc="investment.name"/><t t-if="not investment_last">, </t>
                                                    </t>
                                                </t>
                                                <span t-else="">All</span>
                                            </div>
                                        </div>
                                        <div class="row" style="color:black;" t-if="o.date_to">
                                            <div class="col-4"><b>Date To:</b></div>
                                            <div class="col-8">
                                                <span t-field="o.date_to"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div class="row">
                            <div class="col-12">
                                <t t-foreach="data" t-as="record">
                                    <table class="table table-bordered font-weight-bold" style="line-height: 1.2px !important;font-size:12px !important;">
                                        <thead class="text-center">
                                            <tr style="background-color:#191970;color:#fff;">
                                                <th t-attf-colspan="#{len(record['inventory_rows']) + 2}" class="text-center text-uppercase">
                                                    inventory status - <span class="text-uppercase" t-esc="record['investor'].investor_id"/>
                                                </th>
                                            </tr>
                                            <tr style="background-color:#fda902;color:#000;">
                                                <th/>
                                                <th>Total</th>
                                                <th t-foreach="record['inventory_rows']" t-as="cat" t-esc="cat['category']"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Units Assigned</td>
                                                <td class="text-center"><span t-esc="len(record['files'])"/></td>
                                                <td t-foreach="record['inventory_rows']" t-as="cat" class="text-center"><span t-esc="cat['assigned']"/></td>
                                            </tr>
                                            <tr>
                                                <td>Units Sold</td>
                                                <td class="text-center"><span t-esc="len(record['sold_files'])"/></td>
                                                <td t-foreach="record['inventory_rows']" t-as="cat" class="text-center"><span t-esc="cat['sold']"/></td>
                                            </tr>
                                            <tr>
                                                <td>Units Available</td>
                                                <td class="text-center"><span t-esc="len(record['available_files'])"/></td>
                                                <td t-foreach="record['inventory_rows']" t-as="cat" class="text-center"><span t-esc="cat['available']"/></td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <table class="table table-bordered" style="line-height: 1.2px !important;font-size:12px !important;">
                                        <thead>
                                            <tr style="background-color:#191970;color:#fff;">
                                                <th colspan="4" class="text-center text-uppercase">payment details</th>
                                            </tr>
                                            <tr style="background-color:#fda902;color:#000;">
                                                <th/>
                                                <th class="text-center">Amount</th>
                                                <th class="text-center">Dealer Rebate</th>
                                                <th class="text-center">Paid</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Booking and Confirmation rows hidden per client request
