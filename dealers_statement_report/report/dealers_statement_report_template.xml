                                                <td class="text-right"><span t-esc="record['confirmation_amount_paid']" t-options='{"widget": "float", "precision": 2}'/></td>
                                            </tr> -->
                                            <tr>
                                                <td>Total</td>
                                                <td class="text-right"><span t-esc="record['down_payment_amount']" t-options='{"widget": "float", "precision": 2}'/></td>
