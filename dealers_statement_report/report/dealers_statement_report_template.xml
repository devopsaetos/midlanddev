                                                <td class="text-right"><span t-esc="record['down_payment_amount']" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td class="text-right"><span t-esc="record['down_payment_rebate']" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td class="text-right"><span t-esc="record['down_payment_amount_paid']" t-options='{"widget": "float", "precision": 2}'/></td>
                                            </tr>
                                            <!-- <tr>
