<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dealers_statement_report_wizard_view_form" model="ir.ui.view">
        <field name="name">dealer.statement.wizard.form</field>
        <field name="model">dealer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Dealer Statement Report">
                <group>
                    <group>
                        <field name="investor_id"/>
                        <field name="date_from"/>
                        <field name="report_type"/>
                    </group>
                    <group>
                        <field name="investment_ids" widget="many2many_tags"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="process_report" string="Print PDF" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="dealers_statement_report_action" model="ir.actions.act_window">
        <field name="name">Dealer Statement Report</field>
        <field name="res_model">dealer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dealers_statement_report_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
            name="Dealer Statement Report"
            id="dealers_statement_report_wizards_menu"
            parent="file_financials.reports_menu_item"
            action="dealers_statement_report_action"
            sequence="10"
    />
</odoo>
