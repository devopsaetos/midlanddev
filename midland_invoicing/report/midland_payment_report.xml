<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_midland_payment" model="report.paperformat">
        <field name="name">Midland Payment Receipt</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <!-- Portrait: Office and Customer copy are stacked top/bottom on
             one sheet (report_midland_payment_document). -->
        <field name="orientation">Portrait</field>
        <!-- 0: each copy carries its own top padding instead, so the two
             half-sheet copies are identical and the cut line lands on the
             sheet's exact middle. -->
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         REPORT ACTION
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_report_midland_payment" model="ir.actions.report">
        <field name="name">Payment Receipt</field>
        <field name="model">midland.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">midland_invoicing.report_midland_payment_document</field>
        <field name="report_file">midland_invoicing.report_midland_payment_document</field>
        <field name="binding_model_id" ref="model_midland_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Payment Receipt - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_midland_payment"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         REUSABLE BLOCK — ek copy ka pura design
    ═══════════════════════════════════════════════════════════ -->
    <template id="report_midland_payment_copy">
        <!-- Exactly half an A4 sheet: both copies print on one page (see
             report_midland_payment_document). The fixed height (not
             min-height) is what puts the cut line at the sheet's exact
             middle - see copy_height there. -->
        <div t-attf-style="font-size:11px; font-family: Arial, sans-serif; margin:0; height:#{copy_height}; overflow:hidden; page-break-inside:avoid; box-sizing:border-box;">
        <!-- Content is vertically centred in its half, so the blank space
             above the letterhead matches the space below "Printed By". -->
        <table t-attf-style="width:100%; height:#{copy_height}; border-collapse:collapse;"><tr><td style="vertical-align:middle; padding:8px 0 0 0;">

            <!-- Letterhead, same on both copies: logo | project name + tagline
                 | the group company's name and address, top right as on the
                 other reports (root of the payment's company tree - Shabraj
                 Developers for Capital Valley receipts). -->
            <t t-set="header_company" t-value="o.company_id.root_id or o.company_id"/>
            <t t-set="header_project" t-value="o._receipt_project_name()"/>
            <t t-set="header_tagline" t-value="o._receipt_project_tagline()"/>
            <t t-set="address" t-value="header_company.partner_id"/>
            <table style="width:100%; margin-bottom:6px; border-collapse:collapse;">
                <tr>
                    <td style="width:28%; vertical-align:middle; text-align:left;">
                        <img t-if="header_company.logo" t-att-src="image_data_uri(header_company.logo)"
                             style="max-height:80px; max-width:150px;"/>
                    </td>
                    <td style="width:44%; vertical-align:middle; text-align:center; color:#5a4a4d;">
                        <div t-if="header_project" style="font-size:30px; letter-spacing:8px; line-height:1.1; text-transform:uppercase; white-space:nowrap;">
                            <span t-esc="header_project"/>
                        </div>
                        <div t-if="header_tagline" style="font-size:10px; letter-spacing:3px; margin-top:3px; text-transform:uppercase;">
                            <span t-esc="header_tagline"/>
                        </div>
                    </td>
                    <td style="width:28%; vertical-align:top; text-align:right; font-size:11px; line-height:1.35; color:#222;">
                        <div style="font-weight:bold; font-size:12px;"><span t-esc="header_company.name"/></div>
                        <div t-if="address.street"><span t-esc="address.street"/></div>
                        <div t-if="address.street2"><span t-esc="address.street2"/></div>
                        <div t-if="address.city or address.country_id">
                            <span t-esc="', '.join(filter(None, [address.city, address.country_id.name]))"/>
                        </div>
                    </td>
                </tr>
            </table>

            <table style="width:auto; margin:0 auto; border-collapse:collapse;" cellspacing="0" cellpadding="0">
                <tr>
                    <td style="background:#40a4d5; padding:3px 20px; text-align:center;">
                        <h2 style="color:white; margin:0; padding:0; letter-spacing:2px; font-size:16px;">PAYMENT
                            RECEIPT
                        </h2>
                    </td>
                </tr>
            </table>
            <p style="text-align:center; letter-spacing:3px; margin:3px 0 8px 0; padding:0; font-weight:bold; font-size:11px; color:#40a4d5;">
                <span t-esc="copy_label"/>
            </p>

            <table style="width:100%; margin-bottom:8px;">
                <tr>
                    <td style="width:50%; vertical-align:top;">
                        <table>
                            <tr>
                                <td style="width:160px; font-weight:bold; padding:2px 0; white-space:nowrap;">Customer
                                    Name:
                                </td>
                                <td style="padding-left:35px;">
                                    <span t-field="o.partner_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:160px; font-weight:bold; padding:2px 0; white-space:nowrap;">Payment
                                    Method:
                                </td>
                                <td style="padding-left:35px;">
                                    <span t-esc="o._receipt_payment_method()"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:160px; font-weight:bold; padding:2px 0; white-space:nowrap;">Payment
                                    Journal:
                                </td>
                                <td style="padding-left:35px;">
                                    <span t-field="o.journal_id.name"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td style="width:50%; vertical-align:top;">
                        <table style="margin-left:auto;">
                            <tr>
                                <td style="width:100px; font-weight:bold; padding:2px 0; white-space:nowrap;">Receipt
                                    #:
                                </td>
                                <td style="padding-left:35px;">
                                    <span t-field="o.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:100px; font-weight:bold; padding:2px 0; white-space:nowrap;">Memo:</td>
                                <td style="padding-left:35px;">
                                    <span t-field="o.remarks"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:100px; font-weight:bold; padding:2px 0; white-space:nowrap;">Date:</td>
                                <td style="padding-left:35px;">
                                    <span t-field="o.date"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <table style="width:100%; border-collapse:collapse;" border="1">
                <thead>
                    <tr style="background:#40a4d5; color:white; font-weight:normal;">
                        <th style="padding:5px; font-weight:normal;">
                            <t t-if="o.payment_for == 'investor'">Investor No.</t>
                            <t t-else="">File No.</t>
                        </th>
                        <th style="padding:5px; font-weight:normal;">Category</th>
                        <!-- File receipts keep the plot's unit size (Product);
                             dealer receipts have none. -->
                        <th t-if="o.payment_for != 'investor'" style="padding:5px; font-weight:normal;">Product</th>
                        <th style="padding:5px; font-weight:normal;">Payment Type</th>
                        <th style="padding:5px; font-weight:normal;">
                            <t t-if="o.payment_for == 'investor'">Total Num. of Units</t>
                            <t t-else="">Unit Number</t>
                        </th>
                        <th style="padding:5px; font-weight:normal;">Due Date</th>
                        <th style="padding:5px; font-weight:normal;">Total</th>
                        <th style="padding:5px; font-weight:normal;">Paid</th>
                        <th style="padding:5px; font-weight:normal;">Discount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.invoice_line_ids" t-as="line">
                        <td style="padding:5px; white-space:nowrap;">
                            <span t-field="line.invoice_id.receipt_ref"/>
                        </td>
                        <td style="padding:5px;">
                            <span t-field="line.invoice_id.receipt_category"/>
                        </td>
                        <td t-if="o.payment_for != 'investor'" style="padding:5px; white-space:nowrap;">
                            <span t-field="line.invoice_id.receipt_unit_size"/>
                        </td>
                        <!-- An invoice ticked "Advance Payment" prints as Advance,
                             not its product (e.g. Down Payment). -->
                        <td style="padding:5px;">
                            <t t-if="line.invoice_id.is_advance_payment">Advance</t>
                            <span t-else="" t-field="line.invoice_id.receipt_product"/>
                        </td>
                        <td style="padding:5px;">
                            <t t-if="o.payment_for == 'investor'">
                                <span t-field="line.invoice_id.receipt_unit_count"/>
                            </t>
                            <t t-else="">
                                <span t-field="line.invoice_id.receipt_unit_no"/>
                            </t>
                        </td>
                        <!-- The invoice's own plan-line date (Down Payment date,
                             Installment 1 date, ...) - payment line due_date is
                             never filled in. -->
                        <td style="padding:5px; text-align:center; white-space:nowrap;">
                            <t t-set="due" t-value="line.invoice_id.installment_id.date or line.invoice_id.investment_installment_id.date or line.due_date"/>
                            <span t-if="due" t-esc="due" t-options="{'widget': 'date'}"/>
                        </td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs.
                            <t t-esc="'{:,.2f}'.format(line.total)"/>
                        </td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs.
                            <t t-esc="'{:,.2f}'.format(line.payment_amount_paid)"/>
                        </td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs. 0.00</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="font-weight:bold;">
                        <td t-att-colspan="5 if o.payment_for == 'investor' else 6" style="padding:5px;">Total</td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs.
                            <t t-esc="'{:,.2f}'.format(sum(line.total for line in o.invoice_line_ids))"/>
                        </td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs.
                            <t t-esc="'{:,.2f}'.format(sum(line.payment_amount_paid for line in o.invoice_line_ids))"/>
                        </td>
                        <td style="padding:5px; text-align:right; white-space:nowrap;">Rs. 0.00</td>
                    </tr>
                </tfoot>
            </table>

            <p style="margin-top:8px; font-weight:bold; font-size:13px;">
                <strong>Amount In Words:</strong>
                <span t-esc="o.currency_id.amount_to_text(sum(line.payment_amount_paid for line in o.invoice_line_ids))"/>
            </p>

            <table style="width:100%; margin-top:30px;">
                <tr>
                    <td style="width:33%; text-align:center;">
                        <span t-field="o.create_uid.name" style="color:#40a4d5;"/>
                        <br/>
                        <div style="width:120px; margin:0 auto; border-top:1px solid #40a4d5; padding-top:3px; color:#40a4d5;">
                            Receipt By
                        </div>
                    </td>
                    <td style="width:33%;"></td>
                    <td style="width:33%; text-align:center;">
                        <br/>
                        <div style="width:120px; margin:0 auto; border-top:1px solid #40a4d5; padding-top:3px; color:#40a4d5;">
                            Customer Signature
                        </div>
                    </td>
                </tr>
            </table>

            <table style="width:100%; margin-top:10px;">
                <tr>
                    <td style="width:50%; font-size:12px; color:#40a4d5;">
                        Printed By:
                        <span t-esc="env.user.name"/>
                        On
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                    </td>
                    <td style="width:50%; text-align:right; font-size:12px; color:#40a4d5;">
                        <strong>
                            <span t-field="o.branch_id.name"/>
                        </strong>
                        <br/>
                        <span t-field="o.branch_id.street"/>
                    </td>
                </tr>
            </table>
        </td></tr></table>
        </div>
    </template>

    <!-- ══════════════════════════════════════════════════════════
         MAIN DOCUMENT — 2 copies (Office + Customer) on one sheet
    ═══════════════════════════════════════════════════════════ -->
    <template id="report_midland_payment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- Office and Customer copy share one sheet, split by a
                     dashed cut line; each receipt starts on its own sheet. -->
                <div class="page" t-attf-style="#{'' if o_first else 'page-break-before: always;'}">
                    <t t-call="midland_invoicing.report_midland_payment_copy">
                        <t t-set="copy_label">OFFICE COPY</t>
                        <!-- Calibrated against the rendered PDF: 657px here puts
                             the cut line at 148.5mm, the exact middle of A4
                             (with this paperformat's 0 top margin / dpi 90). -->
                        <t t-set="copy_height" t-value="'657px'"/>
                    </t>

                    <!-- Cut line: zero-height, so it sits exactly on the
                         boundary between the two equal halves. -->
                    <div style="height:0; border-top:1px dashed #999;"/>

                    <t t-call="midland_invoicing.report_midland_payment_copy">
                        <t t-set="copy_label">CUSTOMER COPY</t>
                        <!-- A little short of a full half, so the sheet never
                             spills a trailing blank page. -->
                        <t t-set="copy_height" t-value="'650px'"/>
                    </t>
                </div>

            </t>
        </t>
    </template>

</odoo>