<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit real_estate investment form: add smart button + Generate Invoices button -->
    <record id="investment_form_midland_invoice_ext" model="ir.ui.view">
        <field name="name">investment.form.midland.invoice.ext</field>
        <field name="model">investment</field>
        <field name="inherit_id" ref="real_estate.investment_view_form"/>
        <field name="arch" type="xml">

            <!-- Old account.move-based "Invoices" button — superseded by the
                 midland.invoice smart button below, this deal type no longer
                 creates account.move invoices directly. -->
            <button name="open_invoices" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <!-- Smart button in button_box -->
            <div name="button_box" position="inside">
                <button name="action_view_midland_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="midland_invoice_count == 0">
                    <field name="midland_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>

            <!-- Reset to Draft + Create/Reset Installment Plan + Generate Invoices
                 buttons in header (before state statusbar). Create/Reset
                 Installment Plan are relocated here (out of the Installment
                 Plan tab, where they used to sit above the plan lines list)
                 so the whole deal-progression sequence reads left to right. -->
            <field name="state" position="before">
                <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        confirm="This releases the reserved inventory and clears the installment plan. Continue?"
                        invisible="state != 'reserved' or midland_invoice_count &gt; 0"/>
                <button name="create_installment_plan" position="move"/>
                <button name="reset_installment_plan" position="move"/>
                <button name="action_generate_installment_invoices"
                        string="Generate Invoices"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'reserved' or midland_invoice_count &gt; 0 or installment_created != True"/>
            </field>

            <!-- Receive Payment only makes sense once invoices actually exist
                 to pay — hide it alongside Generate Invoices/Reset to Draft
                 flipping, instead of as soon as the deal is Reserved. -->
            <button name="receive_payment" position="attributes">
                <attribute name="invisible">state != 'reserved' or midland_invoice_count == 0</attribute>
            </button>

            <!-- Assign Plan / Add Inventory only make sense before the
                 installment plan exists - once Create Installment Plan has
                 been used, hide both so the header doesn't keep offering
                 pre-plan setup actions. -->
            <button name="action_open_assign_plan_wizard" position="attributes">
                <attribute name="invisible">state != 'reserved' or plan_type != 'predefine' or not header_plan_required or installment_created == True</attribute>
            </button>
            <button name="action_open_add_inventory_wizard" position="attributes">
                <attribute name="invisible">state != 'reserved' or reservation_type != 'unit' or installment_created == True</attribute>
            </button>

            <!-- Payments tab: receive_payment()'s midland.payment rows have no
                 account.payment counterpart, so they need their own column -->
            <xpath expr="//field[@name='investment_payment_view_ids']/list/field[@name='payment_id']" position="after">
                <field name="midland_payment_id" string="Payment" invisible="not midland_payment_id"/>
            </xpath>

        </field>
    </record>

    <!-- Inherit land_development investment form: same smart button + Generate Invoices button -->
    <record id="building_investment_form_midland_invoice_ext" model="ir.ui.view">
        <field name="name">building.investment.form.midland.invoice.ext</field>
        <field name="model">investment</field>
        <field name="inherit_id" ref="land_development.investment_view_form"/>
        <field name="arch" type="xml">

            <!-- Old account.move-based "Invoices" button — superseded by the
                 midland.invoice smart button below, this deal type no longer
                 creates account.move invoices directly. -->
            <button name="open_invoices" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <!-- Smart button in button_box -->
            <div name="button_box" position="inside">
                <button name="action_view_midland_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="midland_invoice_count == 0">
                    <field name="midland_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>

            <!-- Reset to Draft + Create/Reset Installment Plan + Generate Invoices
                 buttons in header (before state statusbar) - mirrors the
                 housing-society view above. -->
            <field name="state" position="before">
                <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        confirm="This releases the reserved inventory and clears the installment plan. Continue?"
                        invisible="state != 'reserved' or midland_invoice_count &gt; 0"/>
                <button name="create_installment_plan" position="move"/>
                <button name="reset_installment_plan" position="move"/>
                <button name="action_generate_installment_invoices"
                        string="Generate Invoices"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'reserved' or midland_invoice_count &gt; 0 or installment_created != True"/>
            </field>

            <!-- Receive Payment only makes sense once invoices actually exist
                 to pay — hide it alongside Generate Invoices/Reset to Draft
                 flipping, instead of as soon as the deal is Reserved. -->
            <button name="receive_payment" position="attributes">
                <attribute name="invisible">state == 'payment' or midland_invoice_count == 0</attribute>
            </button>

            <!-- Payments tab: receive_payment()'s midland.payment rows have no
                 account.payment counterpart, so they need their own column -->
            <xpath expr="//field[@name='investment_payment_view_ids']/list/field[@name='payment_id']" position="after">
                <field name="midland_payment_id" string="Payment" invisible="not midland_payment_id"/>
            </xpath>

        </field>
    </record>

</odoo>
