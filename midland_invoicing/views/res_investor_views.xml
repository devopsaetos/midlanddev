<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_investor_form_dealer_advance_ext" model="ir.ui.view">
        <field name="name">res.investor.form.dealer.advance.ext</field>
        <field name="model">res.investor</field>
        <field name="inherit_id" ref="real_estate.investor_registration_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="currency_id" invisible="1"/>
                <button name="action_view_dealer_advance_ledger"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="not dealer_advance_balance">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="dealer_advance_balance" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Advance Balance</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
