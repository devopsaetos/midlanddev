<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Odoo 19: base.res_config_settings_view_form's core <form> is now completely empty
         (settings blocks are assembled differently) and no longer has a
         //div[hasclass('settings')] node to xpath into, so the old inherited xpath here would
         fail to load. Converted to a standalone settings form (inherit_id eval="False") using
         the new <app>/<block>/<setting> structure, following the same pattern already applied
         in real_estate/views/res_config_setting.xml. Only reachable via this module's own
         "Settings" menu item below, not via Odoo's General Settings app. -->
    <record id="maintenance_recovery_batch.res_config_settings_view_form" model="ir.ui.view">
        <field name="name">maintenance_recovery_batch.res_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" eval="False"/>
        <!-- Deliberately high: this is a second, unrelated root view for res.config.settings/form.
             Odoo's default view resolution (no explicit view_id) picks the root view with the
             lowest priority; this must never win that tie against the true base view
             (res.config.settings.view.form, priority 16), or Odoo's native Settings app ends up
             showing only this Maintenance Recovery block instead of the full merged settings
             screen. Same fix already applied in real_estate/views/res_config_setting.xml. -->
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <form string="Maintenance Recovery Settings" class="oe_form_configuration" js_class="base_settings">
                <app name="maintenance_recovery_batch" string="Maintenance Charges">
                    <block title="Maintenance Invoice Settings">
                        <setting help="Product used on monthly maintenance (utility) invoices.">
                            <field name="maintenance_product_id" options="{'no_create': True}"/>
                        </setting>
                        <setting help="Product used on service / electricity charges invoices.">
                            <field name="society_product_id" options="{'no_create': True}"/>
                        </setting>
                        <setting help="Sales journal used when maintenance invoices are created for this company.">
                            <field name="maintenance_invoice_journal_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                    <block title="Maintenance Payment Settings">
                        <setting help="Cash / bank journal offered first on Maintenance Charges Payment and Daily Transactions.">
                            <field name="maintenance_payment_journal_id" string="Maintenance Payment Journal" options="{'no_create': True}"/>
                        </setting>
                    </block>
                    <!-- fields from maintenance_monthly_bill (scheduled action "Generate Monthly Utility Bills") -->
                    <block title="Automatic Utility Bills">
                        <setting help="Every month, make the Draft utility bills of every house of each society / phase that has a Maintenance Charges rule for the month. Houses that already have the month's bill, or that no rule matches, are skipped.">
                            <field name="auto_utility_bills"/>
                            <div class="mt8" invisible="not auto_utility_bills">
                                <div class="row">
                                    <label for="auto_utility_day" class="col-lg-4 o_light_label"/>
                                    <field name="auto_utility_day" class="col-lg-2"/>
                                </div>
                                <div class="row">
                                    <label for="auto_utility_due_day" class="col-lg-4 o_light_label"/>
                                    <field name="auto_utility_due_day" class="col-lg-2"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_generate_utility_bills_now" type="object" icon="oi-arrow-right"
                                        string="Generate This Month's Bills Now" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>
    <record
            id="maintenance_recovery_batch.maintenance_configs_action"
            model="ir.actions.act_window">

        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="maintenance_recovery_batch.res_config_settings_view_form"/>
        <field name="target">current</field>
        <field name="context">{'module' : 'maintenance_recovery_batch'}</field>
    </record>
    <!-- Configuration menu: maintenance_charges.menu_maintenance_config_root -->
    <menuitem id="maintenance_recovery_batch.menu_maintenance_charges_settings" name="Settings" parent="maintenance_charges.menu_maintenance_config_root"
              sequence="10"
              action="maintenance_recovery_batch.maintenance_configs_action"/>
</odoo>
