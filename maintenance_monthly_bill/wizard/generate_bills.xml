<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="maintenance_bill_generate_form" model="ir.ui.view">
            <field name="name">maintenance.bill.generate.form</field>
            <field name="model">maintenance.bill.generate</field>
            <field name="arch" type="xml">
                <form string="Generate Monthly Bills">
                    <group>
                        <group string="Which Houses">
                            <field name="bill_type" invisible="1"/>
                            <field name="society_id"/>
                            <field name="phase_id"/>
                            <field name="file_ids" widget="many2many_tags" context="{'show_unit_number': True}"
                                   placeholder="Pick houses (empty = all houses)" options="{'no_create': True}"/>
                        </group>
                        <group string="Month">
                            <field name="bill_month"/>
                            <field name="due_date"/>
                            <field name="journal_id"/>
                            <field name="surcharge_percent"/>
                        </group>
                    </group>
                    <group>
                        <group string="Utility" invisible="bill_type != 'utility'">
                            <field name="utility_product_id"/>
                            <field name="default_utility_amount"/>
                        </group>
                        <group string="Electricity" invisible="bill_type != 'electricity'">
                            <field name="electricity_product_id"/>
                            <field name="unit_rate"/>
                        </group>
                    </group>
                    <group string="Import Readings from Excel" invisible="bill_type != 'electricity'">
                        <div class="text-muted" colspan="2">
                            1. Choose the society (and phase or houses), month and rate above, then click
                            <b>Download Template</b>: an Excel sheet of those houses with their meter and previous reading.<br/>
                            2. Fill the <b>Current Reading</b> column (Meter No / Rate only if they changed) and save.<br/>
                            3. Upload the file here and click <b>Import &amp; Generate</b>: one electricity draft bill per house.
                        </div>
                        <button name="action_download_template" string="Download Template" type="object"
                                icon="fa-download" class="btn-secondary" colspan="2"/>
                        <field name="import_filename" invisible="1"/>
                        <field name="import_file" filename="import_filename"/>
                    </group>
                    <group string="Printed on the Bill">
                        <field name="bank_note"/>
                        <field name="payment_note"/>
                    </group>
                    <footer>
                        <button name="action_generate" string="Generate Draft Bills" type="object" class="btn-primary"
                                invisible="bill_type == 'electricity' and import_file"/>
                        <button name="action_import_readings" string="Import &amp; Generate" type="object" class="btn-primary"
                                icon="fa-upload" invisible="bill_type != 'electricity' or not import_file"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_maintenance_bill_generate" model="ir.actions.act_window">
            <field name="name">Generate Utility Bills</field>
            <field name="res_model">maintenance.bill.generate</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_bill_type': 'utility'}</field>
        </record>

        <record id="action_maintenance_bill_generate_electricity" model="ir.actions.act_window">
            <field name="name">Generate Electricity Bills</field>
            <field name="res_model">maintenance.bill.generate</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_bill_type': 'electricity'}</field>
        </record>

        <menuitem id="menu_maintenance_bill_generate" name="Generate Utility Bills"
                  action="action_maintenance_bill_generate"
                  parent="menu_maintenance_bill_root" sequence="10"/>
        <menuitem id="menu_maintenance_bill_generate_electricity" name="Generate Electricity Bills"
                  action="action_maintenance_bill_generate_electricity"
                  parent="menu_maintenance_bill_root" sequence="20"/>
    </data>
</odoo>
