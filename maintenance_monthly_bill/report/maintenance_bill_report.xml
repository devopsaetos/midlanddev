<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_maintenance_bill" model="report.paperformat">
        <field name="name">Maintenance Bill A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_maintenance_bill" model="ir.actions.report">
        <field name="name">Monthly Bill (3 Copies)</field>
        <field name="model">maintenance.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_monthly_bill.report_maintenance_bill</field>
        <field name="report_file">maintenance_monthly_bill.report_maintenance_bill</field>
        <field name="print_report_name">'%s %s %s' % ({'utility': 'Utility Bill', 'electricity': 'Electricity Bill'}.get(object.bill_type, 'Bill'), object.unit_number or '', object.bill_month and object.bill_month.strftime('%b-%Y') or '')</field>
        <field name="paperformat_id" ref="paperformat_maintenance_bill"/>
        <field name="binding_model_id" ref="model_maintenance_bill"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_maintenance_bill_copy">
        <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
        <t t-set="dt" t-value="lambda d: d and d.strftime('%d-%b-%Y') or ''"/>
        <table class="mb-copy">
            <tr>
                <td class="mb-top">
                    <table class="mb-head">
                        <tr>
                            <td class="mb-logo">
                                <img t-if="not o.company_id.uses_default_logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                            </td>
                            <td class="mb-titles">
                                <div class="mb-company" t-out="o.company_id.name"/>
                                <div class="mb-society" t-out="(o.society_id.name or '').upper()"/>
                                <div class="mb-title" t-out="copy_title"/>
                                <div class="mb-subtitle"><t t-out="o._bill_title()"/></div>
                            </td>
                            <td class="mb-logo"/>
                        </tr>
                    </table>
                    <div class="mb-bank" t-out="o.bank_note"/>

                    <table class="mb-info">
                        <colgroup><col style="width: 25%;"/><col style="width: 26%;"/><col style="width: 21%;"/><col style="width: 28%;"/></colgroup>
                        <tr>
                            <td class="lbl">Name:</td><td class="val wrap" colspan="3"><t t-out="o.member_name"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Plot Info:</td><td class="val"><t t-out="o.unit_number"/></td>
                            <td class="lbl">Billing:</td><td class="val"><t t-out="o.bill_month and o.bill_month.strftime('%b-%Y')"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Date of Issue:</td><td class="val"><t t-out="dt(o.issue_date)"/></td>
                            <td class="lbl">Due Date:</td><td class="val"><t t-out="dt(o.due_date)"/></td>
                        </tr>
                        <tr t-if="o._has_electricity()">
                            <td class="lbl">Meter No:</td><td class="val"><t t-out="o.meter_no or '-'"/></td>
                            <td class="lbl">Reading:</td>
                            <td class="val"><t t-if="o.current_reading"><t t-out="int(o.previous_reading)"/> to <t t-out="int(o.current_reading)"/></t><t t-else="">-</t></td>
                        </tr>
                        <tr>
                            <td class="lbl">Arrears:</td><td class="val"><t t-out="fmt(o.arrears)"/></td>
                            <t t-if="o._has_electricity()">
                                <td class="lbl">Units:</td><td class="val"><t t-out="int(o.units) if o.current_reading else '-'"/></td>
                            </t>
                            <t t-else=""><td/><td/></t>
                        </tr>
                    </table>

                    <table class="mb-lines">
                        <colgroup><col style="width: 11%;"/><col style="width: 61%;"/><col style="width: 28%;"/></colgroup>
                        <thead>
                            <tr><th>Sr.#</th><th>Description</th><th class="num">Amount</th></tr>
                        </thead>
                        <tbody>
                            <t t-set="sr" t-value="0"/>
                            <tr t-foreach="o._bill_lines()" t-as="line">
                                <t t-set="sr" t-value="sr + 1"/>
                                <td><t t-out="sr"/></td><td><t t-out="line[0]"/></td><td class="num"><t t-out="fmt(line[1])"/></td>
                            </tr>
                            <tr t-foreach="o._arrears_lines()" t-as="line">
                                <td/><td><t t-out="line[0]"/></td><td class="num"><t t-out="fmt(line[1])"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mb-desc" t-if="o._has_utility()">Utility = Water, Sewerage, Security, Street Lights &amp; Maintenance</div>

                    <table class="mb-total">
                        <colgroup><col style="width: 64%;"/><col style="width: 36%;"/></colgroup>
                        <tr><td>Current Month:</td><td class="num"><t t-out="fmt(o.current_amount)"/></td></tr>
                        <tr class="strong"><td>Due Amount:</td><td class="num"><t t-out="fmt(o.due_amount)"/></td></tr>
                        <tr><td>Surcharge on Late Payment:</td><td class="num"><t t-out="fmt(o.surcharge)"/></td></tr>
                        <tr class="strong"><td>Payable after due date:</td><td class="num"><t t-out="fmt(o.payable_after_due)"/></td></tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td class="mb-bottom">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 32%; vertical-align: bottom;">
                                <t t-set="qr" t-value="o._qr_data_uri()"/>
                                <img t-if="qr" t-att-src="qr" style="width: 70px; height: 70px;"/>
                                <div class="mb-small" t-out="o.name"/>
                            </td>
                            <td style="vertical-align: bottom;" class="mb-sign">
                                <div style="margin-bottom: 16px;">Issued By: ________________</div>
                                <div>Received By: ______________</div>
                            </td>
                        </tr>
                    </table>
                    <div class="mb-note" t-out="o.payment_note"/>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_maintenance_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif;">
                    <style>
                        .mb-row { width: 1040px; table-layout: fixed; border-collapse: collapse; margin: 0 auto; }
                        .mb-row > tbody > tr > td.mb-cell { width: 340px; vertical-align: top; padding: 0; }
                        .mb-row > tbody > tr > td.mb-gap { width: 10px; }
                        .mb-copy { width: 340px; height: 738px; border: 1px solid #000; border-collapse: collapse; table-layout: fixed; font-size: 10px; line-height: 1.25; }
                        .mb-top { vertical-align: top; padding: 10px 10px 0 10px; }
                        .mb-bottom { vertical-align: bottom; padding: 0 10px 10px 10px; height: 1px; }
                        .mb-head { width: 100%; table-layout: fixed; border-bottom: 1px solid #000; }
                        .mb-head td { vertical-align: middle; padding-bottom: 6px; }
                        .mb-logo { width: 64px; height: 60px; }
                        .mb-logo img { max-width: 60px; max-height: 56px; }
                        .mb-titles { text-align: center; }
                        .mb-company { font-weight: bold; font-size: 13px; }
                        .mb-society { font-weight: bold; font-size: 10px; letter-spacing: 1px; }
                        .mb-title { font-weight: bold; font-size: 13px; margin-top: 4px; }
                        .mb-subtitle { font-size: 10px; }
                        .mb-bank { text-align: center; font-weight: bold; font-size: 8px; margin: 6px 0 8px 0; height: 22px; overflow: hidden; }
                        .mb-info { width: 100%; table-layout: fixed; margin-bottom: 10px; }
                        .mb-info td { padding: 5px 3px; white-space: nowrap; overflow: hidden; font-size: 11px; }
                        .mb-info td.wrap { white-space: normal; }
                        .mb-info .lbl { font-weight: bold; }
                        .mb-info .val { border-bottom: 1px solid #000; }
                        .mb-lines { width: 100%; table-layout: fixed; border-collapse: collapse; }
                        .mb-lines th, .mb-lines td { border: 1px solid #000; padding: 6px 5px; vertical-align: top; white-space: nowrap; overflow: hidden; font-size: 11px; }
                        .mb-lines th { background: #e9e9e9; text-align: left; }
                        .mb-total { width: 100%; table-layout: fixed; margin-top: 10px; }
                        .mb-total td { padding: 5px 3px; font-size: 11px; }
                        .mb-total tr.strong td { font-weight: bold; font-size: 12px; }
                        .num { text-align: right; white-space: nowrap; }
                        .mb-sign { font-size: 11px; }
                        .mb-small { font-size: 8px; }
                        .mb-note { font-size: 8px; margin-top: 6px; height: 22px; overflow: hidden; }
                        .mb-desc { font-size: 8px; color: #333; margin: 4px 0 0 0; }
                    </style>
                    <table class="mb-row">
                        <tr>
                            <td class="mb-cell"><t t-call="maintenance_monthly_bill.report_maintenance_bill_copy"><t t-set="copy_title" t-value="'Customer Copy'"/></t></td>
                            <td class="mb-gap"/>
                            <td class="mb-cell"><t t-call="maintenance_monthly_bill.report_maintenance_bill_copy"><t t-set="copy_title" t-value="'Society Office Copy'"/></t></td>
                            <td class="mb-gap"/>
                            <td class="mb-cell"><t t-call="maintenance_monthly_bill.report_maintenance_bill_copy"><t t-set="copy_title" t-value="'Bank Copy'"/></t></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
