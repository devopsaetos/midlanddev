<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Runs every day; it only makes bills on the day set in Settings (Automatic Utility Bills). -->
    <record id="ir_cron_generate_utility_bills" model="ir.cron">
        <field name="name">Generate Monthly Utility Bills</field>
        <field name="model_id" ref="model_maintenance_bill_generate"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_utility_bills()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
