<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_partner_advance" model="ir.ui.view">
        <field name="name">account.account.form.partner.advance</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="partner_advance_type"
                       invisible="account_type in ('asset_receivable', 'liability_payable')"/>
            </xpath>
        </field>
    </record>
</odoo>
