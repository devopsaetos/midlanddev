<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ks_dashboard_ninja.ks_am_chart">
        <div class="h-100" t-ref="rootRef">
            <div t-if="props.data.sources.length" class="position-relative h-100 dashboard-container d-flex flex-fill flex-column border-0">
                <div class="card-body p-0" t-ref="chartRef"/>
            </div>
            <t t-else="">
                <div class="d-flex align-items-center justify-content-center h-100 flex-column">
                    <div class="text-center text-muted">
                        <i class="fa fa-chart-line fa-3x mb-3"/>
                        <p>No data available</p>
                    </div>
                    <button t-if="this.drillDownState?.drillDowns?.length" class="btn btn-secondary" t-on-click="() => this.popoverAction?.oneLevelUp()">
                        <i class="fa fa-arrow-up me-2"/>Drill Up
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>