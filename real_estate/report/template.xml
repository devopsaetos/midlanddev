<odoo>
        <record id="paperformat_letter_report2" model="report.paperformat">
            <field name="name">Cash flow report paperformat</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">8</field>
            <field name="dpi">70</field>
        </record>
        <template id="internal_layout1">
            <!-- Multicompany -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/>
            </t>
            <div class="header">
                <div class="row">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"
                             style="max-width: 220px;max-height: 70px;"/>
                    </div>
                    <div class="col-6 text-right" style="font-size:10px;">
                        <strong t-if="company.name">
                            <span t-esc="company.name"/>
                        </strong>
                        <div t-if="company.street">
                            <span t-esc="company.street"/>
                        </div>
                        <div t-if="company.street2">
                            <span t-esc="company.street2"/>
                        </div>
                        <div t-if="company.city">
                            <span t-esc="company.city"/>
                            <t t-if="company.country_id">, <span t-esc="company.country_id.name"/></t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer">
                <div class="row" style="font-size:11px;">
                    <div class="col-6 text-left">
                        Printed By:
                        <span t-esc="o.env.user.name"/>
                        On
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                    </div>
                    <div class="col-6 text-right">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
            <div class="article">
                <t t-raw="0"/>
            </div>
        </template>
    
</odoo>
