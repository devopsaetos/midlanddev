<odoo>
    <!-- Printed at the top of the page body: as a wkhtmltopdf header it overlapped the
         filters on this landscape format. -->
    <template id="maintenance_collection_header">
        <div style="margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid #999;">
            <table class="mc-plain" style="width: 100%; font-family: 'Roboto', sans-serif; color: #000; border: 0;">
                <tr>
                    <td style="width: 30%; vertical-align: middle; border: 0;">
                        <img t-if="not company.uses_default_logo" t-att-src="image_data_uri(company.logo)" alt="Logo"
                             style="max-height: 60px; max-width: 180px;"/>
                    </td>
                    <td style="border: 0; text-align: center; vertical-align: middle; color: #191970; font-size: 18px; font-weight: bold;">
                        MAINTENANCE COLLECTION REPORT
                    </td>
                    <td style="width: 30%; text-align: right; vertical-align: middle; font-size: 12px; border: 0;">
                        <div style="font-weight: bold;" t-out="company.name"/>
                        <t t-foreach="[p for p in (company.street, company.street2, company.city, company.country_id.name) if p]" t-as="part">
                            <div t-out="part"/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>
    </template>
    <template id="maintenance_collection_footer">
        <div class="footer">
            <table class="mc-plain" style="width: 100%; font-size: 11px; font-family: 'Roboto', sans-serif; color: #000; border: 0;">
                <tr>
                    <td style="width: 50%; border: 0;">Printed By: <t t-out="user.name"/></td>
                    <td style="width: 50%; text-align: right; border: 0;">Print Date: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></td>
                </tr>
            </table>
        </div>
    </template>
    <data>
        <template id="maintenance_report_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="maintenance_collection_report.maintenance_collection_footer"/>
                    <t t-call="web.basic_layout">
                        <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                        <t t-set="dt" t-value="lambda d: d and d.strftime('%d-%m-%Y') or ''"/>
                        <style>
                            .mc { font-family: 'Roboto', sans-serif; color: #000; }
                            .mc-filters { width: 100%; table-layout: fixed; margin: 6px 0 14px 0; border: 0; border-collapse: separate; }
                            .mc-filters td { font-size: 13px; padding: 3px 6px; vertical-align: top; border: 0; }
                            .mc-filters td.lbl { font-weight: bold; width: 13%; }
                            .mc-filters td.val { background-color: #f6f6f6; }
                            .mc-t { border-collapse: collapse; margin-bottom: 16px; }
                            .mc-t th, .mc-t td { font-size: 12px; padding: 4px 6px; border: 1px solid #999; }
                            .mc-t thead th, .mc-t tr.mc-sum td { background-color: #191970; color: #fff; font-weight: bold; }
                            .mc-t thead th { text-align: center; }
                            .mc-t th.sub { background-color: #e4e6f2; color: #000; }
                            .mc-t .num { text-align: right; white-space: nowrap; }
                            .mc-t .c { text-align: center; white-space: nowrap; }
                            thead { display: table-header-group; }
                            tr { page-break-inside: avoid; }
                        </style>
                        <div class="page mc">
                            <t t-call="maintenance_collection_report.maintenance_collection_header"/>
                            <table class="mc-filters">
                                <tr>
                                    <td class="lbl">Date From:</td><td class="val"><t t-out="dt(date_from)"/></td>
                                    <td class="lbl">Date To:</td><td class="val"><t t-out="dt(date_to)"/></td>
                                </tr>
                                <tr t-if="category_ids or invoice_type_label">
                                    <td class="lbl">Category:</td><td class="val"><t t-out="', '.join(category_ids.mapped('name'))"/></td>
                                    <td class="lbl">Invoice Type:</td><td class="val"><t t-out="invoice_type_label or 'All'"/></td>
                                </tr>
                                <tr t-if="unit_category_type_ids or sector_id">
                                    <td class="lbl">Product:</td><td class="val"><t t-out="', '.join(unit_category_type_ids.mapped('name'))"/></td>
                                    <td class="lbl">Sector:</td><td class="val"><t t-out="', '.join(sector_id.mapped('name'))"/></td>
                                </tr>
                            </table>

                            <!-- month wise -->
                            <table class="mc-t" style="width: 50%;">
                                <thead>
                                    <tr><th colspan="2">Maintenance Collection Month Wise</th></tr>
                                    <tr><th>Month</th><th>Total</th></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="months_list" t-as="month">
                                        <td class="c"><t t-out="month"/></td>
                                        <td class="num"><t t-out="fmt(month_totals.get(month))"/></td>
                                    </tr>
                                    <tr class="mc-sum">
                                        <td class="c">Grand Total</td>
                                        <td class="num"><t t-out="fmt(total)"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- sector x product -->
                            <table class="mc-t" style="width: 100%;">
                                <thead>
                                    <tr><th t-att-colspan="len(products) + 2">Maintenance Collection Sector &amp; Product Wise</th></tr>
                                    <tr>
                                        <th>Sector</th>
                                        <th t-foreach="products" t-as="product"><t t-out="product[1]"/></th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="sectors" t-as="sector">
                                        <td class="c"><t t-out="sector[1]"/></td>
                                        <td class="num" t-foreach="products" t-as="product"><t t-out="fmt(sector_product.get((sector[0], product[0])))"/></td>
                                        <td class="num"><t t-out="fmt(sum(v for k, v in sector_product.items() if k[0] == sector[0]))"/></td>
                                    </tr>
                                    <tr class="mc-sum">
                                        <td class="c">Grand Total</td>
                                        <td class="num" t-foreach="products" t-as="product"><t t-out="fmt(sum(v for k, v in sector_product.items() if k[1] == product[0]))"/></td>
                                        <td class="num"><t t-out="fmt(total)"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- detail -->
                            <table class="mc-t" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Sr No.</th>
                                        <th>Member</th>
                                        <th>File No.</th>
                                        <th>Sector</th>
                                        <th t-if="show_street">Street</th>
                                        <th>House</th>
                                        <th>Date</th>
                                        <th>Payment</th>
                                        <th>Journal</th>
                                        <th>Type</th>
                                        <th>Category</th>
                                        <th>Product</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="rows" t-as="row">
                                        <t t-set="file" t-value="row['file']"/>
                                        <td class="c"><t t-out="row_index + 1"/>.</td>
                                        <td><t t-out="file.membership_id.name"/></td>
                                        <td><t t-out="file.display_name"/></td>
                                        <td><t t-out="file.sector_id.name"/></td>
                                        <td t-if="show_street"><t t-out="file.street_id.name"/></td>
                                        <td><t t-out="file.unit_number or file.inventory_id.name"/></td>
                                        <td class="c"><t t-out="dt(row['payment'].date)"/></td>
                                        <td><t t-out="row['payment'].name"/></td>
                                        <td><t t-out="row['payment'].journal_id.name"/></td>
                                        <td><t t-out="row['kind']"/></td>
                                        <td><t t-out="file.category_id.name"/></td>
                                        <td><t t-out="file.unit_category_type_id.name"/></td>
                                        <td class="num"><t t-out="fmt(row['amount'])"/></td>
                                    </tr>
                                    <tr class="mc-sum">
                                        <td t-att-colspan="12 if show_street else 11">Total</td>
                                        <td class="num"><t t-out="fmt(total)"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
