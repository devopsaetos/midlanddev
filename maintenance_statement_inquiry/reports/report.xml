<odoo>
    <template id="maintenance_statement_inquiry.maintenance_customized_header">
        <t t-set="company" t-value="o._report_company()"/>
        <div class="header">
            <table style="width: 100%; font-family: 'Roboto', sans-serif; color: #000;">
                <tr>
                    <td style="width: 25%; vertical-align: middle;">
                        <img t-if="not company.uses_default_logo" t-att-src="image_data_uri(company.logo)"
                             alt="Logo" style="max-height: 70px; max-width: 160px;"/>
                    </td>
                    <td style="text-align: center; vertical-align: middle;">
                        <div style="font-size: 18px; font-weight: bold;" t-out="company.name"/>
                        <div style="color: #191970; font-size: 24px; font-weight: bold;">Maintenance Inquiry Report</div>
                    </td>
                    <td style="width: 25%; text-align: right; vertical-align: middle; font-size: 11px;">
                        <t t-foreach="[p for p in (company.street, company.street2, company.city) if p]" t-as="part">
                            <div t-out="part"/>
                        </t>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="maintenance_statement_inquiry.maintenance_customized_footer">
        <div class="footer">
            <table style="width: 100%; font-size: 11px; font-family: 'Roboto', sans-serif; color: #191970;">
                <tr>
                    <td style="width: 50%;">Printed By: <u t-out="user.name"/></td>
                    <td style="width: 50%; text-align: right;">Print Date: <u t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></td>
                </tr>
            </table>
        </div>
    </template>

    <template id="maintenance_statement_inquiry.report_maintenance_inquiry">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="maintenance_statement_inquiry.maintenance_customized_header"/>
                <t t-call="maintenance_statement_inquiry.maintenance_customized_footer"/>
                <t t-call="web.basic_layout">
                    <t t-set="dt" t-value="lambda d: d and d.strftime('%d-%m-%Y') or ''"/>
                    <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <style>
                        .mq { font-family: 'Roboto', sans-serif; color: #000; }
                        .mq-info { width: 100%; table-layout: fixed; margin: 10px 0 14px 0; }
                        .mq-info td { font-size: 14px; padding: 3px 4px; vertical-align: top; }
                        .mq-info td.lbl { font-weight: bold; width: 14%; }
                        .mq-lines { width: 100%; border-collapse: collapse; }
                        .mq-lines th, .mq-lines td { font-size: 12px; padding: 5px 4px; border: 1px solid #999; }
                        .mq-lines th { background-color: #191970; color: #fff; text-align: center; font-weight: bold; white-space: nowrap; }
                        .mq-lines tbody tr:nth-child(even) td { background-color: #f4f5fa; }
                        .mq-lines tbody tr.mq-total td { background-color: #191970; color: #fff; font-weight: bold; }
                        .mq-lines .c { text-align: center; white-space: nowrap; }
                        .mq-lines .num { text-align: right; white-space: nowrap; }
                        thead { display: table-header-group; }
                        tr { page-break-inside: avoid; }
                    </style>
                    <div class="page mq">
                        <table class="mq-info">
                            <tr>
                                <td class="lbl">Society:</td><td><t t-out="o.society_id.name"/></td>
                                <td class="lbl">House:</td><td><t t-out="o.house_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Phase:</td><td><t t-out="o.phase_id.name"/></td>
                                <td class="lbl">Member:</td><td><t t-out="o.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Sector:</td><td><t t-out="o.sector_id.name"/></td>
                                <td class="lbl">Size:</td><td><t t-out="o.size_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Category:</td><td><t t-out="o.category_id.name"/></td>
                                <td class="lbl">Type:</td><td><t t-out="o.unit_class_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="lbl">Product:</td><td><t t-out="o.unit_category_type_id.name"/></td>
                                <t t-if="o.street_id">
                                    <td class="lbl">Street:</td><td><t t-out="o.street_id.name"/></td>
                                </t>
                                <t t-else=""><td/><td/></t>
                            </tr>
                        </table>

                        <!-- same order as the screen: newest first -->
                        <t t-set="lines" t-value="o.maintenance_inquiry_line_ids"/>
                        <table class="mq-lines">
                            <thead>
                                <tr>
                                    <th>Sr No.</th>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Invoice #</th>
                                    <th>Payment Date</th>
                                    <th>Amount</th>
                                    <th>Amount Paid</th>
                                    <th>Amount Due</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td class="c"><t t-out="line_index + 1"/>.</td>
                                    <td class="c"><t t-out="dt(line.date)"/></td>
                                    <td><t t-out="line.description"/></td>
                                    <td class="c"><t t-out="line.invoice_id.name"/></td>
                                    <td class="c"><t t-out="dt(line.payment_date)"/></td>
                                    <td class="num"><t t-out="fmt(line.amount)"/></td>
                                    <td class="num"><t t-out="fmt(line.amount_paid)"/></td>
                                    <td class="num"><t t-out="fmt(line.residual)"/></td>
                                    <td class="c"><t t-out="dict(line._fields['payment_status']._description_selection(line.env)).get(line.payment_status, '')"/></td>
                                </tr>
                                <tr class="mq-total">
                                    <td colspan="5">Total</td>
                                    <td class="num"><t t-out="fmt(sum(lines.mapped('amount')))"/></td>
                                    <td class="num"><t t-out="fmt(sum(lines.mapped('amount_paid')))"/></td>
                                    <td class="num"><t t-out="fmt(sum(lines.mapped('residual')))"/></td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width: 100%; margin-top: 110px; color: #191970; font-size: 13px;">
                            <tr>
                                <td style="width: 33%;"><t t-out="o.create_uid.name"/></td>
                                <td/><td/>
                            </tr>
                            <tr>
                                <td style="width: 33%;"><span style="text-decoration: overline;">Prepared By</span></td>
                                <td style="width: 34%; text-align: center;"><span style="text-decoration: overline;">Approved By</span></td>
                                <td style="width: 33%; text-align: right;"><span style="text-decoration: overline;">Received By</span></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="maintenance_statement_inquiry.maintenance_paper_format" model="report.paperformat">
        <field name="name">Customized Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <!-- Odoo 19: the <report .../> XML shortcut tag no longer exists in core (removed from
         odoo/tools/convert.py); report actions must be declared as plain ir.actions.report
         records (same pattern used elsewhere in this project, e.g.
         maintenance_collection_report/report/report.xml). -->
    <record id="action_maintenance_inquiry_report" model="ir.actions.report">
        <field name="name">Maintenance Inquiry Report</field>
        <field name="model">maintenance.inquiry.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_statement_inquiry.report_maintenance_inquiry</field>
        <field name="report_file">maintenance_statement_inquiry.report_maintenance_inquiry</field>
        <field name="paperformat_id" ref="maintenance_paper_format"/>
    </record>
</odoo>
