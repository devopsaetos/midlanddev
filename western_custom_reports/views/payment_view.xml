<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_custom_print" model="ir.ui.view">
        <field name="name">account.payment.form.custom.print</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(western_custom_reports.action_report_vendor_payment_custom)d"
                        string="Print"
                        type="action"
                        class="btn btn-secondary"
                        invisible="state == 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
