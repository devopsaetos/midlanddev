<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="maintenance_charges_customized_footer">
        <div class="footer">
            <div class="row" style="font-size:11px;font-family:'Roboto',sans-serif;color:#2b4c7e;">
                <div class="col-4 text-center" style="margin-top:40px;">
                    <span>Printed By:
                        <span t-esc="request.env.user.name"/>
                    </span>
                </div>
                <div class="col-4 text-center" style="margin-top:50px;"/>

                <div class="col-4 text-center" style="margin-top:50px;">
                    <span>Print Date:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                    </span>
                </div>
            </div>
        </div>
    </template>

    <!-- One copy of the invoice. Expects `o` (account.move), `i` (values from the report
         model's _invoice_info) and `copy_title`. -->
    <template id="maintenance_invoice_report_copy">
        <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
        <t t-set="dt" t-value="lambda d: d and d.strftime('%d-%m-%Y') or ''"/>
        <t t-set="file" t-value="o.file_ids[:1]"/>
        <table class="mi-copy">
            <tr>
                <td class="mi-top">
                    <table class="mi-head">
                        <tr>
                            <td class="mi-logo">
                                <img t-if="not o.company_id.uses_default_logo"
                                     t-att-src="image_data_uri(o.company_id.logo)" alt="Logo"/>
                            </td>
                            <td class="mi-titles">
                                <div class="mi-company" t-out="o.company_id.name"/>
                                <div class="mi-copyname" t-out="copy_title"/>
                                <div class="mi-title" t-out="i['title']"/>
                                <div class="mi-number" t-out="o.name"/>
                            </td>
                            <td class="mi-address">
                                <t t-foreach="i['address']" t-as="part">
                                    <div t-out="part"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <table class="mi-info">
                        <colgroup><col style="width: 20%;"/><col style="width: 34%;"/><col style="width: 22%;"/><col style="width: 24%;"/></colgroup>
                        <tr>
                            <td class="lbl">Customer</td><td class="val"><t t-out="o.partner_id.name"/></td>
                            <td class="lbl">Invoice Date</td><td class="val"><t t-out="dt(o.invoice_date)"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Phone</td><td class="val"><t t-out="i['phone']"/></td>
                            <td class="lbl">Due Date</td><td class="val"><t t-out="dt(i['due_date'])"/></td>
                        </tr>
                    </table>

                    <div class="mi-section">Plot Details</div>
                    <table class="mi-info mi-box">
                        <colgroup><col style="width: 20%;"/><col style="width: 34%;"/><col style="width: 22%;"/><col style="width: 24%;"/></colgroup>
                        <tr>
                            <td class="lbl">Society</td><td><t t-out="file.society_id.name"/></td>
                            <td class="lbl">Category</td><td><t t-out="file.category_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Phase</td><td><t t-out="file.phase_id.name"/></td>
                            <td class="lbl">Size</td><td><t t-out="i['size']"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Sector</td><td><t t-out="file.sector_id.name"/></td>
                            <td class="lbl">Type</td><td><t t-out="file.unit_class_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="lbl"><t t-if="file.street_id">Street</t></td><td><t t-out="file.street_id.name"/></td>
                            <td class="lbl">House No</td><td><t t-out="i['house_no']"/></td>
                        </tr>
                    </table>

                    <t t-if="i['electricity']">
                        <div class="mi-section">Electricity Details</div>
                        <table class="mi-meter">
                            <tr>
                                <th>Previous Reading</th><th>Current Reading</th><th>Units</th><th>Rate / Unit</th>
                            </tr>
                            <tr>
                                <td><t t-out="i['electricity']['previous']"/></td>
                                <td><t t-out="i['electricity']['current']"/></td>
                                <td><t t-out="i['electricity']['units']"/></td>
                                <td><t t-out="fmt(i['electricity']['rate'])"/></td>
                            </tr>
                        </table>
                    </t>

                    <table class="mi-lines">
                        <colgroup><col style="width: 68%;"/><col style="width: 32%;"/></colgroup>
                        <thead>
                            <tr><th>Description</th><th class="num">Amount</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="i['rows']" t-as="row">
                                <td><t t-out="row[0]"/></td>
                                <td class="num"><t t-out="fmt(row[1])"/></td>
                            </tr>
                            <tr>
                                <td><strong>Arrears</strong></td>
                                <td class="num"><t t-out="fmt(i['arrears'])"/></td>
                            </tr>
                            <tr class="mi-total">
                                <td>Total Amount</td>
                                <td class="num"><t t-out="fmt(i['total'])"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mi-words">
                        <strong>Amount In Words:</strong>
                        <span t-out="i['amount_words']"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="mi-bottom">
                    <div class="mi-approved"><span>Approved By</span></div>
                    <table class="mi-printed">
                        <tr>
                            <td>Printed By: <t t-out="user.name"/></td>
                            <td class="num">Print Date: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <template id="maintenance_invoice_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="i" t-value="info[o.id]"/>
                <div class="page" style="font-family: 'Roboto', Arial, sans-serif;">
                    <style>
                        .mi-row { width: 100%; table-layout: fixed; border-collapse: collapse; }
                        .mi-row > tbody > tr > td.mi-cell { width: 32%; vertical-align: top; padding: 0; }
                        .mi-row > tbody > tr > td.mi-gap { width: 2%; border-left: 1px dashed #777; }
                        .mi-copy { width: 100%; height: 820px; border: 1.5px solid #000; border-collapse: collapse; table-layout: fixed; color: #000; }
                        .mi-copy td, .mi-copy th, .mi-copy div { font-size: 13px; line-height: 1.3; }
                        .mi-top { vertical-align: top; padding: 14px 16px 0 16px; }
                        .mi-bottom { vertical-align: bottom; padding: 0 16px 12px 16px; height: 1px; }
                        .mi-head { width: 100%; table-layout: fixed; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid #000; }
                        .mi-head td { vertical-align: middle; }
                        .mi-logo { width: 22%; }
                        .mi-logo img { max-width: 80px; max-height: 70px; }
                        .mi-titles { text-align: center; }
                        .mi-copy .mi-address, .mi-copy .mi-address div { width: 22%; text-align: right; font-size: 10px; }
                        .mi-copy .mi-company { font-weight: bold; font-size: 16px; }
                        .mi-copy .mi-copyname { font-weight: bold; font-size: 12px; text-decoration: underline; margin-top: 3px; }
                        .mi-copy .mi-title { font-weight: bold; font-size: 15px; margin-top: 3px; }
                        .mi-copy .mi-number { font-size: 13px; }
                        .mi-info { width: 100%; table-layout: fixed; margin-bottom: 10px; }
                        .mi-info td { padding: 3px 4px; white-space: nowrap; overflow: hidden; }
                        .mi-info .lbl { font-weight: bold; }
                        .mi-info td.val { border-bottom: 1px solid #999; }
                        .mi-box { border: 1px solid #ccc; }
                        .mi-copy .mi-section { color: #2b4c7e; font-weight: bold; font-size: 14px; margin: 6px 0 4px 0; }
                        .mi-meter { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 10px; }
                        .mi-meter th, .mi-meter td { border: 1px solid #999; padding: 3px 4px; text-align: center; }
                        .mi-meter th { background: #eef0f7; font-weight: bold; }
                        .mi-lines { width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 10px; }
                        .mi-lines th { background: #e8eef8; color: #1f2a44; font-weight: bold; text-align: left; padding: 5px 6px; border: 1px solid #c5cee0; }
                        .mi-lines td { border: 1px solid #c5cee0; padding: 5px 6px; vertical-align: top; }
                        .mi-lines tr.mi-total td { font-weight: bold; background: #f3f5f9; }
                        .mi-copy .mi-words { color: #2b4c7e; margin-top: 12px; }
                        .mi-copy .mi-approved { text-align: right; margin: 0 10px 24px 0; color: #2b4c7e; }
                        .mi-approved span { border-top: 1px solid #2b4c7e; padding: 2px 16px 0 16px; }
                        .mi-printed { width: 100%; color: #2b4c7e; }
                        .mi-copy .mi-printed td { font-size: 11px; }
                        .num { text-align: right; white-space: nowrap; }
                    </style>
                    <table class="mi-row">
                        <tr>
                            <td class="mi-cell"><t t-call="maintenance_invoice_report.maintenance_invoice_report_copy"><t t-set="copy_title" t-value="'BANK COPY'"/></t></td>
                            <td class="mi-gap"/>
                            <td class="mi-cell"><t t-call="maintenance_invoice_report.maintenance_invoice_report_copy"><t t-set="copy_title" t-value="'ACCOUNT COPY'"/></t></td>
                            <td class="mi-gap"/>
                            <td class="mi-cell"><t t-call="maintenance_invoice_report.maintenance_invoice_report_copy"><t t-set="copy_title" t-value="'CUSTOMER COPY'"/></t></td>
                        </tr>
                    </table>
                </div>
                <p t-if="not o_last" style="page-break-before: always"/>
            </t>
        </t>
    </template>

    <record id="paperformat_maintainance_charges_invoice" model="report.paperformat">
        <field name="name">Customized Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">360</field>
        <field name="page_width">210</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <!-- Odoo 19: the <report .../> XML shortcut tag no longer exists in core (it has been
         removed from odoo/tools/convert.py); report actions must be declared as plain
         ir.actions.report records. menu="False" is preserved by not setting
         binding_model_id/binding_type, so this report action is not exposed in the Print menu. -->
    <record id="action_maintenance_invoice_report" model="ir.actions.report">
        <field name="name">Maintenance Charges Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_invoice_report.maintenance_invoice_report</field>
        <field name="report_file">maintenance_invoice_report.maintenance_invoice_report</field>
        <field name="paperformat_id" ref="paperformat_maintainance_charges_invoice"/>
    </record>
</odoo>
